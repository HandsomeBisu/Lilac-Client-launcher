{
  "name": "lilac-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Lilac Client desktop launcher",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:auth": "node scripts/prepare-auth-config.cjs",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/smoke.cjs && node --check src/model.js && node --check src/app.js",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "electron . --smoke-test"
  },
  "devDependencies": {
    "electron": "45.2.3"
  },
  "dependencies": {
    "@azure/msal-node": "7.2.1"
  }
}
